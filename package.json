{
  "name": "nexus-terminal",
  "productName": "Nexus",
  "version": "1.2.0",
  "description": "One terminal to orchestrate Claude, Antigravity and shells across your LAN",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true
  },
  "devDependencies": {
    "electron-builder": "^26.15.3",
    "electron": "^44.5.1"
  },
  "author": "mirrorsedgepro-stack",
  "repository": {
    "type": "git",
    "url": "https://github.com/mirrorsedgepro-stack/Spark-Orchestrator.git"
  },
  "build": {
    "appId": "com.nexus.terminal",
    "productName": "Nexus",
    "artifactName": "Nexus-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "assets/**",
      "scripts/**",
      "package.json",
      "!**/*.map",
      "!renderer/_*"
    ],
    "asarUnpack": [
      "scripts/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mirrorsedgepro-stack",
        "repo": "Spark-Orchestrator",
        "releaseType": "release"
      }
    ]
  }
}
